<launch>

  <node pkg="map_server" type="map_server" name="map_server"
        args="$(find lab2_team1)/maps/map.yaml" />

  <include file="$(find turtlebot3_bringup)/launch/turtlebot3_remote.launch">
    <arg name="model" value="waffle"/>
  </include>

  <node pkg="lab2_team1" type="astar_node.py" name="astar_planner" output="screen"/>

  <node pkg="lab2_team1" type="turtlebot_control.py" name="turtlebot_controller" output="screen"/>

  <node pkg="rviz" type="rviz" name="rviz"
        args="-d $(find lab2_team1)/config/lab2_config.rviz"/>

</launch>
